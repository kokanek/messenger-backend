# Local development defaults. Copy to .env: `cp .env.example .env`.
# Production uses its own .env on the VM with real secrets (never committed).

NODE_ENV=development
LOG_LEVEL=debug

# Gateway: ":80" is plain HTTP inside the container, published on localhost:8080.
SITE_ADDRESS=:80
ALLOWED_ORIGINS=http://localhost:5180

# Secrets (dev values only)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
INTERNAL_TOKEN=dev-only-internal-token

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-dev-password

POSTGRES_PASSWORD=postgres-dev
AUTH_DB_PASSWORD=auth-dev
MESSAGE_DB_PASSWORD=message-dev
CREATE_TEST_DATABASES=true

MONGO_ROOT_PASSWORD=mongo-dev
CONVERSATION_DB_PASSWORD=conversation-dev
